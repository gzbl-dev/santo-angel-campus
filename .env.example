# Copia este fichero a .env y ajusta los valores. .env no se versiona.
DRUPAL_PORT=8080
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=drupal
DB_ROOT_PASSWORD=root
# Genera uno con: php -r "echo bin2hex(random_bytes(32));"
DRUPAL_HASH_SALT=solo-para-desarrollo-cambiar-en-produccion
DRUPAL_TRUSTED_HOSTS=localhost,127.0.0.1
DRUPAL_ADMIN_PASSWORD=admin
