<?php

/**
 * @file
 * Funciones de preprocesado del tema Santo Ángel.
 */

declare(strict_types=1);

use Drupal\Core\Field\FieldItemListInterface;
use Drupal\node\NodeInterface;

/**
 * Cabecera (antetítulo y entradilla) de las páginas propias del campus.
 */
function _santoangel_route_header(?string $route): ?array {
  return match ($route) {
    'sa_core.titulaciones' => [
      'eyebrow' => t('Oferta académica'),
      'lead' => t('Grados, másteres y ciclos formativos. Filtra por rama, modalidad o tipo de estudio.'),
    ],
    'sa_core.eventos' => [
      'eyebrow' => t('Agenda'),
      'lead' => t('Jornadas, talleres, competiciones y actividades culturales abiertas a toda la comunidad.'),
    ],
    'sa_core.faq' => [
      'eyebrow' => t('Ayuda'),
      'lead' => t('Respuestas rápidas sobre matrícula, becas, gestión académica y vida en el campus.'),
    ],
    default => NULL,
  };
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function santoangel_preprocess_page(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  $route = $route_match->getRouteName();
  $variables['page_header'] = ['eyebrow' => NULL, 'lead' => NULL];
  $variables['current_year'] = date('Y');

  if ($header = _santoangel_route_header($route)) {
    $variables['page_header'] = $header;
    return;
  }

  $node = $route_match->getParameter('node');
  if ($route !== 'entity.node.canonical' || !$node instanceof NodeInterface) {
    return;
  }

  $variables['page_header'] = match ($node->bundle()) {
    'titulacion' => [
      'eyebrow' => implode(' · ', array_filter([
        _santoangel_option_label($node->get('field_tipo')),
        _santoangel_option_label($node->get('field_rama')),
      ])),
      'lead' => $node->get('field_resumen')->value,
    ],
    'evento' => [
      'eyebrow' => _santoangel_option_label($node->get('field_categoria_evento')),
      'lead' => $node->get('field_resumen')->value,
    ],
    'faq' => ['eyebrow' => t('Preguntas frecuentes'), 'lead' => NULL],
    default => $variables['page_header'],
  };
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function santoangel_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  $date_formatter = \Drupal::service('date.formatter');

  switch ($node->bundle()) {
    case 'titulacion':
      $variables['badge'] = _santoangel_option_label($node->get('field_tipo'));
      $variables['badge_key'] = $node->get('field_rama')->value;
      $variables['facts'] = [
        ['label' => t('Tipo'), 'value' => _santoangel_option_label($node->get('field_tipo'))],
        ['label' => t('Rama'), 'value' => _santoangel_option_label($node->get('field_rama'))],
        ['label' => t('Modalidad'), 'value' => _santoangel_option_label($node->get('field_modalidad'))],
        ['label' => t('Créditos'), 'value' => $node->get('field_creditos')->value . ' ECTS'],
      ];
      break;

    case 'evento':
      $date = $node->get('field_fecha')->date;
      $timestamp = $date?->getTimestamp();
      $variables['badge'] = _santoangel_option_label($node->get('field_categoria_evento'));
      $variables['badge_key'] = $node->get('field_categoria_evento')->value;
      $variables['event_date'] = $timestamp ? [
        'iso' => $date->format('c'),
        'day' => $date_formatter->format($timestamp, 'custom', 'j'),
        'month' => $date_formatter->format($timestamp, 'custom', 'M'),
        'long' => $date_formatter->format($timestamp, 'custom', 'l j \d\e F \d\e Y, H:i'),
      ] : NULL;
      $variables['facts'] = [
        ['label' => t('Cuándo'), 'value' => $variables['event_date']['long'] ?? ''],
        ['label' => t('Dónde'), 'value' => $node->get('field_lugar')->value],
        ['label' => t('Categoría'), 'value' => $variables['badge']],
      ];
      break;
  }
}

/**
 * Etiqueta legible de un campo de lista ("grado" => "Grado").
 */
function _santoangel_option_label(FieldItemListInterface $items): ?string {
  $value = $items->value;
  if ($value === NULL || $value === '') {
    return NULL;
  }

  $allowed = options_allowed_values(
    $items->getFieldDefinition()->getFieldStorageDefinition(),
    $items->getEntity(),
  );

  return isset($allowed[$value]) ? (string) $allowed[$value] : (string) $value;
}
